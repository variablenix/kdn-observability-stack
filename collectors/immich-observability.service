[Unit]
Description=Read-only Immich observability aggregates
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=immich-monitor
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 /opt/immich-observability/immich_textfile.py --config /etc/immich-observability.json --output /var/lib/node_exporter/textfile_collector/immich.prom
TimeoutStartSec=90
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/node_exporter/textfile_collector

[Install]
WantedBy=multi-user.target
